# Files read by Linux tools (Docker, sh) always keep LF line endings,
# even when the repo is checked out on Windows.
Dockerfile       text eol=lf
Dockerfile.*     text eol=lf
.dockerignore    text eol=lf
*.sh             text eol=lf

# Binary model files: never touch line endings or diff them as text.
*.pkl            binary


# Don't count notebooks in the language stats
*.ipynb linguist-detectable=false
